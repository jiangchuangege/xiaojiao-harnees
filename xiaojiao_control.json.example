{
  "_说明": "小焦的「操控文件」模板。复制成 xiaojiao_control.json 后按需修改；该文件含本地密钥，已被 .gitignore 忽略，切勿提交。",
  "_版本": "对应 v1.0（含 brain.xiaojiao 小脑路径 与 scrapling 抓取段）",

  "brain": {
    "_说明": "大脑=聊天主模型；小脑=自研 MiniGPT（项目核心，必需）",
    "llama": {
      "server": "",                                  "//server": "llama-server.exe 路径；留空=自动探测",
      "gguf": "",                                    "//gguf": "聊天大脑 GGUF 路径；留空=自动探测（全盘按关键词+体积）",
      "ctx": 20224,                                  "//ctx": "上下文窗口。**默认 20224**：llama.cpp 会把 -c 向上取整到 256 的倍数（实测 -c 20000 实际给 20224），这里直接写实测值，载体算出的 token 上限才和大脑真容量对齐，不白浪费窗口"
    },
    "api": {
      "base_url": "http://127.0.0.1:9292/v1",        "//base_url": "任意 OpenAI 兼容端点；llama-swap 默认 9292",
      "model": "xiaojiao",
      "api_key": "env:XIAOJIAO_API_KEY",             "//api_key": "云端模型才需要；本地留空最省事。密钥推荐放**环境变量 XIAOJIAO_API_KEY**（优先级高于这里，且密钥不落文件）；这里也可以写 env:变量名 表示去读那个环境变量"
    },
    "llama_swap_port": 9292,
    "comfy_dir": "",                                 "//comfy_dir": "ComfyUI 目录（视频大脑）；留空=自动探测",
    "keep_warm": true,
    "xiaojiao": {
      "_说明": "小脑三件套。三项都可留空=自动探测（环境变量 > 本配置 > 全盘扫描）",
      "model_path": "mini_gpt_model.pth",
      "vocab_path": "vocab.pkl",
      "config_path": "model_config.json"
    }
  },

  "scrapling": {
    "_说明": "网页抓取插件（plugins/scrapling_bridge.py）：想抓啥抓啥",
    "archify_root": "",                              "//archify_root": "Archify 画图插件的安装根目录。**留空即可**——插件会自动扫描常见位置（~/.dsh/profiles/*/node_modules/@tt-a1i/archify-dsh/skills/archify、npm 全局、./vendor/archify）。自动检测失败时才填，格式示例：C:\\Users\\你的用户名\\.dsh\\profiles\\web\\node_modules\\@tt-a1i\\archify-dsh\\skills\\archify",
    "mode": "auto",                                  "//mode": "auto=进程内优先(最稳) | mcp=强制走 MCP | inproc",
    "scrapling_mcp_url": "",                         "//scrapling_mcp_url": "仅 mcp+http 模式需要，如 http://127.0.0.1:8000/mcp",
    "executable_path": "",                           "//executable_path": "自备 Chrome 路径；留空=自动探测/用内置 Chromium",
    "proxy_list": [],                                "//proxy_list": "代理池，逐条轮换；单个代理最多用 5 次",
    "rate_limit": 1.0,                               "//rate_limit": "同域最小请求间隔（秒），默认 1.0",
    "timeout": 60,                                   "//timeout": "单次抓取超时（秒）",
    "max_retries": 3,
    "circuit_breaker_threshold": 3,                  "//circuit_breaker_threshold": "连续失败几次触发熔断",
    "circuit_breaker_timeout": 30,                   "//circuit_breaker_timeout": "熔断冷却秒数（到点自动恢复）",
    "allow_robots_skip": false,                      "//allow_robots_skip": "true=robots.txt 明确禁止时也抓（默认 false；也可在对话里说「忽略 robots 抓一次」）",

    "_会话回收": "开一次会话就真起一个浏览器，忘了关会一直占内存 —— 下面三条规则任一命中即自动回收",
    "max_sessions": 20,                              "//max_sessions": "同时最多保留几个会话；超出时踢掉最久未使用的（LRU）",
    "session_ttl": 1800,                             "//session_ttl": "单个会话最长存活秒数（默认 30 分钟，到期强制回收）",
    "session_idle": 300,                             "//session_idle": "空闲多少秒没用就回收（默认 5 分钟）",

    "_批量并发": "不同域名可以同时抓（快），同一个域名永远不并发打（礼貌）；非法值会让批量工具直接报中文错误",
    "batch": {
      "concurrency": 3,                              "//concurrency": "跨域同时抓几个（≥1，实测 3 个域可从 6.2s 降到 0.9s）",
      "per_domain_limit": 1,                         "//per_domain_limit": "同一域名同时最多几个请求（默认 1=串行，别把人家打挂）",
      "rate_limit": 1.0,                             "//rate_limit": "同域最小间隔（秒）",
      "max_retries": 3,                              "//max_retries": "429/失败重试次数（0~10）",
      "backoff_base": 1.0,                           "//backoff_base": "退避基数（秒）：1→2→4→8"
    }
  },

  "role": "你是“小焦”（xiaojiao1.0-4B），一个本地部署的联网搜索 AI 助手。擅长联网检索并像人一样自然、有条理地回答。先结论后展开，简洁中文，必要时分点。不要机械复读，要自然接话。\n[检索铁律] ① 调用 web_search 时，query 只能是内容关键词（如「最近的漏洞 CVE」「2026 年 AI 新闻」），禁止把「用/搜/找/抓/看/搞/请/帮」这类功能字、语气词或整句话当检索词；② 漏洞/CVE/高危类问题优先调用 collect_vulnerabilities(days=7, severity=\"HIGH\", limit=5)，不要用新闻搜索代替；③ 用户没说清要搜什么时，先反问「请告诉我你要搜索的具体关键词」，绝不用单个字去搜。",

  "capabilities": {
    "plugins": {},                                  "//plugins": "插件开关表：写成对象，形如 {\"插件名\": true}（例 {\"memory\": true}）。不能写布尔值 true —— 代码里是 CAP.get('plugins', {}).get(k, ...)，给 true 会抛 AttributeError: 'bool' object has no attribute 'get'，直接让 import 失败。留空 {} 表示每个插件用自己的默认开关",

    "_安全说明": "以下四项是安全开关（第一批安全加固）；默认值即最安全的配置，一般不用改",

    "lan_access": false,                             "//lan_access": "true=允许局域网访问（默认 false，只听 127.0.0.1）。开了必须同时设 access_token，否则小焦会拒绝开启局域网",
    "access_token": "",                              "//access_token": "局域网访问令牌：非本机请求需带 Header `X-Auth-Token: <令牌>` 或网址加 `?token=<令牌>`；本机访问免令牌。建议填一段随机串（如 32 位）",
    "full_access": false,                            "//full_access": "true=全权限（危险命令不询问直接执行，不建议）；false=危险命令先发原文给你、回复「确认」才执行（默认）",
    "rate_limit_per_minute": 30,                     "//rate_limit_per_minute": "聊天接口每分钟最多多少次（默认 30，突发 5；防误触/防把云端额度刷爆）",

    "_六个无限_输出无限": "用户要「写 N 字」时，载体多次请求 + 无缝合并（去重/断句/校验），前端边生成边收；短内容不触发，用户无感。默认值如下，一般不用改",
    "continuation_enabled": true,                    "//continuation_enabled": "总开关：false=不做长文续写（退回单次回答）",
    "continuation_chunk_size": 2000,                 "//continuation_chunk_size": "单次请求的输出上限（token）",
    "continuation_max_retries": 3,                   "//continuation_max_retries": "某一段校验不通过时的重试次数上限",
    "continuation_summary_interval": 5,              "//continuation_summary_interval": "每写几段重算一次「已写梗概」（给下一段当锚点）",
    "continuation_buffer_size": 3,                   "//continuation_buffer_size": "并发预取的缓冲池大小（预生成几段，段间无空档）",
    "continuation_parallel_prefetch": true,          "//continuation_parallel_prefetch": "true=边推流边预取下一段；false=串行（慢但不占并发）",
    "continuation_min_chars": 800,                   "//continuation_min_chars": "任务里写明目标字数且 ≥ 这个值才走续写（低于它按普通回答）",

    "_六个无限_记忆无限": "历史对话永久存 logs/xiaojiao_memory_vec.jsonl（外部文件，不占模型 ctx），每轮按需检索 top-K 注入 system",
    "memory_top_k": 5,                               "//memory_top_k": "最多注入几条相关记忆",
    "memory_threshold": 0.6,                         "//memory_threshold": "相似度阈值（判在**原始余弦**上；时间衰减只影响排序，不会把老记忆踢出阈值）",
    "memory_max_tokens": 2000,                       "//memory_max_tokens": "注入记忆占的 token 上限"
  },
  "generators": {
    "_说明": "生成类功能的统一入口（core/generator_connector.py）。类别 → 关键词表；用户说一句就由载体自己走完整条链路，不需要点任何 UI。加新功能：加一行即可，不用改代码。",
    "video":   ["视频", "短片", "动画", "影片", "做个视频", "生成个视频", "video"],
    "podcast": ["播客", "音频节目", "电台", "podcast", "做一期节目"],
    "music":   ["音乐", "BGM", "曲子", "配乐", "来段歌", "music", "背景音乐"],
    "blog":    ["博客", "文章", "长文", "写一篇", "公众号", "blog"],
    "code":    ["代码", "函数", "脚本", "写个程序", "实现一个", "写段代码", "code"]
  },
  "_quality_check_batch_size_说明": "批处理质检的批大小（段）。调小 → 用户更流畅、医生更累；调大 → 用户会卡顿、医生更省。见 docs/carrier-diagnosis.md。",
  "quality_check_batch_size": 10
}
